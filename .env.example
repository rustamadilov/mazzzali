POSTGRES_USER=mazzzali
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=mazzzali
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Set AZURE_FUNCTIONS_ENVIRONMENT=Development only for local emulator use.
AZURE_FUNCTIONS_ENVIRONMENT=Development
FUNCTIONS_WORKER_RUNTIME=node
AzureWebJobsStorage=UseDevelopmentStorage=true
AZURITE_BLOB_URL=http://127.0.0.1:10000/devstoreaccount1

# Required for API sessions. Use a random value of at least 32 bytes outside local development.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ISSUER=https://mazzzali.local
JWT_AUDIENCE=mazzzali-web

# Production PostgreSQL and Blob Storage use managed identity.
AZURE_POSTGRES_HOST=
AZURE_POSTGRES_DATABASE=
AZURE_POSTGRES_USER=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_BLOB_ENDPOINT=