{
  "name": "mazzzali-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/mazzzali-api/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "start": "func start",
    "migrate": "node-pg-migrate up --migrations-dir migrations --database-url-var DATABASE_URL",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --database-url-var DATABASE_URL",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@azure/functions": "^4.16.5",
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "bcryptjs": "^3.0.2",
    "express": "^4.21.2",
    "jose": "^6.1.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
